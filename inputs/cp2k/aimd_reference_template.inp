&GLOBAL
  PROJECT aimd_reference
  RUN_TYPE MD
&END GLOBAL

&FORCE_EVAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME BASIS_MOLOPT
    POTENTIAL_FILE_NAME GTH_POTENTIALS
    &MGRID
      CUTOFF 360
      REL_CUTOFF 50
      NGRIDS 4
    &END MGRID
    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE DFTD3(BJ)
          PARAMETER_FILE_NAME dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM .TRUE.
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT
  &SUBSYS
    # Add CELL, COORD, KIND sections here.
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &MD
    ENSEMBLE NPT_I
    STEPS 200000
    TIMESTEP 1.0
    TEMPERATURE 1173
    &THERMOSTAT
      TYPE NOSE
      &NOSE
        LENGTH 3
        YOSHIDA 3
        TIMECON 150
      &END NOSE
    &END THERMOSTAT
    &BAROSTAT
      PRESSURE 1.0
      TIMECON 3000
    &END BAROSTAT
  &END MD
&END MOTION
