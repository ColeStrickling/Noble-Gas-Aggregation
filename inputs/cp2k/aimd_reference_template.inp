&GLOBAL
  PROJECT kcl_2ar_npt_1173K_20ps
  RUN_TYPE MD
  PRINT_LEVEL LOW
&END GLOBAL

&FORCE_EVAL
  STRESS_TENSOR ANALYTICAL
  METHOD Quickstep
  &DFT
    BASIS_SET_FILE_NAME  BASIS_MOLOPT
    POTENTIAL_FILE_NAME  GTH_POTENTIALS

    &MGRID
      CUTOFF     360
      REL_CUTOFF 50
      NGRIDS     4
    &END MGRID

    &QS
      METHOD GPW
      EPS_DEFAULT 1.0E-10
      EXTRAPOLATION ASPC
    &END QS

    &SCF
      SCF_GUESS ATOMIC
      EPS_SCF   1.0E-6
      MAX_SCF   30

      &OT
        PRECONDITIONER FULL_SINGLE_INVERSE
        MINIMIZER DIIS
      &END OT

      &OUTER_SCF
        EPS_SCF 1.0E-5
        MAX_SCF 5
      &END OUTER_SCF
    &END SCF

    &XC
      &XC_FUNCTIONAL PBE
      &END XC_FUNCTIONAL
      &VDW_POTENTIAL
        POTENTIAL_TYPE PAIR_POTENTIAL
        &PAIR_POTENTIAL
          TYPE                 DFTD3(BJ)
          PARAMETER_FILE_NAME  dftd3.dat
          REFERENCE_FUNCTIONAL PBE
          CALCULATE_C9_TERM    .TRUE.
          REFERENCE_C9_TERM    .TRUE.
          R_CUTOFF             10
        &END PAIR_POTENTIAL
      &END VDW_POTENTIAL
    &END XC
  &END DFT

  &SUBSYS
    &CELL
      ABC 23.000 23.000 23.000
      PERIODIC XYZ
    &END CELL

    &TOPOLOGY
      COORD_FILE_NAME   kcl_2ar.xyz
      COORD_FILE_FORMAT XYZ
    &END TOPOLOGY

    &KIND K
      BASIS_SET  DZVP-MOLOPT-SR-GTH     
      POTENTIAL  GTH-PBE
    &END KIND
    &KIND Cl
      BASIS_SET  DZVP-MOLOPT-SR-GTH     
      POTENTIAL  GTH-PBE
    &END KIND
    &KIND Ar
      BASIS_SET  DZVP-MOLOPT-SR-GTH    
      POTENTIAL  GTH-PBE
    &END KIND
  &END SUBSYS
&END FORCE_EVAL

&MOTION
  &PRINT
    &TRAJECTORY
      FORMAT XYZ
      FILENAME kcl_2ar_out.xyz
      &EACH
        MD 20       
      &END EACH
    &END TRAJECTORY

    &VELOCITIES
      &EACH
        MD 1000
      &END EACH
    &END VELOCITIES

    &CELL
      &EACH
        MD 20
      &END EACH
    &END CELL

    &RESTART
      BACKUP_COPIES 3
      &EACH
        MD 1000
      &END EACH
    &END RESTART
    &RESTART_HISTORY OFF
    &END RESTART_HISTORY
  &END PRINT
  &MD
    ENSEMBLE     NPT_F
    TEMPERATURE  1173.0
    TIMESTEP     1.0
    STEPS        20000

    &THERMOSTAT
      TYPE NOSE
      REGION GLOBAL
      &NOSE
        LENGTH 3
        YOSHIDA 3
        TIMECON 150.0
      &END NOSE
    &END THERMOSTAT

    &BAROSTAT
      PRESSURE 1.0
      TIMECON  3000.0
    &END BAROSTAT

    &PRINT
      &ENERGY
        &EACH
          MD 10
        &END EACH
      &END ENERGY
    &END PRINT
  &END MD
&END MOTION


