# LAMMPS input script for KCl
variable        T equal 1173
variable        relaxSteps equal 1000000
variable        prodSteps equal 6000000
variable        thermoSteps equal 100000
log             log.lammps_NVT_1173_6_2 

units           real
atom_style      full
dimension       3
boundary        p p p

pair_style      hybrid born/coul/long 15.0 lj/cut 15.0
pair_modify     tail yes
kspace_style    ewald 1.0e-5

read_data       NVT_1173_6.data

pair_coeff      1 1 lj/cut 0.2398296 3.405
pair_coeff      1 3 born/coul/long 3.229 0.298 3.178 4834.231 3914.066
pair_coeff      1 2 born/coul/long 8.081 0.332 3.029 2940.305 127.239
pair_coeff      2 2 born/coul/long 3.649 0.342 3.170 1791.961 -3598.315
pair_coeff      2 3 born/coul/long 4.864922507 0.337 3.048 690.877 -1050.708
pair_coeff      3 3 born/coul/long 6.081153134 0.337 2.926 349.756 -345.43

neighbor        3.0 bin
neigh_modify    every 1 delay 0 check yes page 1000000 one 20000 

group           ar type 1
group           cl type 2
group 		      k type 3
group           kcl union k cl
region          box block INF INF INF INF INF INF

timestep        1.0
thermo          ${thermoSteps}
thermo_style    custom step temp density vol lx ly lz press ke pe etotal etail enthalpy

#minimize 1.0e-4 1.0e-6 100 1000
#dump            1 all custom 1 $T.lammpstraj id type xu yu zu
#dump_modify     1 sort id

#fix             1 all nvt temp $T $T 1000.0
#fix             stable all momentum 10000 knear 1 1 1 angular
#run             ${relaxSteps}
#unfix           1

reset_timestep  0
fix 		pmf_bias all plumed plumedfile plumed_6.dat outfile plumed_6.out

fix             1 all nvt temp $T $T 1000.0
dump            1 all custom 1000 $T_NVT_6_2.lammpstrj id type x y z vx vy vz
dump_modify     1 sort id
run             ${prodSteps}
write_data      NVT_$T_6_2.data
