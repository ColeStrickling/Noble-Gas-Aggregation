# LAMMPS NVT production template for diffusion/MSD analysis
units real
atom_style full
boundary p p p

read_data data.equilibrated
include ../../force_fields/lammps_include/UPDATE_SYSTEM.in.settings

timestep 1.0
thermo 1000
thermo_style custom step temp press pe ke etotal

fix nvt_all all nvt temp 1173.0 1173.0 100.0

# Option 1: dump unwrapped trajectory and compute MSD in post-processing
dump traj all custom 1000 traj.lammpstrj id type xu yu zu

run 20000000
